<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- win-* RID 需要 net10.0-windows 才能使用 WinForms（NotifyIcon tray）；
         其他平台用純 net10.0 即可。Build script 傳 -r win-x64 時 SDK 會在 evaluate 前
         設好 RuntimeIdentifier，所以這裡可以用條件式切換 TFM。 -->
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$(RuntimeIdentifier.StartsWith('win'))">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 版本號 SSOT 是 repo 根目錄的 VERSION 檔（純文字，一行 SemVer），這裡讀進來自動變成組件的
       AssemblyVersion/FileVersion/InformationalVersion，不用每次改版手動同步這裡。frontend/
       package.json 的 version 跟 backend/packaging/macos/Info.plist 的 CFBundleVersion 目前還是
       手動對齊（2026-08-31 起，還不到值得建自動同步 pipeline 的規模，只有三個地方要對）。 -->
  <PropertyGroup>
    <VersionFilePath>$(MSBuildThisFileDirectory)../VERSION</VersionFilePath>
    <Version Condition="Exists('$(VersionFilePath)')">$([System.IO.File]::ReadAllText('$(VersionFilePath)').Trim())</Version>
  </PropertyGroup>

  <!-- 純 <OutputType>Exe</OutputType> 在 Windows 上會編成 console 子系統，雙擊打開時一個黑底
       終端機視窗會跟 Photino 的 GUI 視窗一起跳出來，不是乾淨的桌面 app 體驗（2026-08-31 第一次
       跨平台編 Windows 版才實測到，file 指令確認過 .exe 是 "console" 子系統）。WinExe 才是 Windows
       上正常桌面 app 用的子系統；只在編 Windows 目標時覆寫，macOS/Linux 不受影響（那兩個平台不分
       這兩種子系統）。也不用擔心 print usage 這個 console debug 旗標會壞掉：WinExe 子系統的
       app 從既有終端機執行時 Console.WriteLine 一樣正常輸出，只是雙擊不會多開黑視窗。 -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <!-- Windows 版現在真的要是一支可雙擊的單檔 app，不再要求使用者先解出旁邊的 wwwroot/
         資料夾。IncludeAllContentForSelfExtract 會把 Angular build 產物一起塞進 bundle，執行時
         解到 .NET 的單檔暫存目錄；Program.cs 會從那裡找出 wwwroot 再用 loopback HTTP 提供給
         WebView2。這一層是修「下載後只是 zip 裡一堆檔案」的關鍵，不是只有 PublishSingleFile。 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built Angular output (populated by scripts/build.sh). Mark as Content so publish includes it,
         and do NOT exclude it from single-file bundling — Windows release depends on these files being
         extracted at runtime for the local UI server. -->
    <Content Include="wwwroot\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always"
             ExcludeFromSingleFile="false"
             Condition="Exists('wwwroot')" />
    <!-- Windows 單檔發布再保一份嵌入式資源：single-file bundle 對內容檔不保證提供可直接開檔的
         實體路徑，Program.cs 會在找不到實體 wwwroot 時，從這批資源自行解到 temp 後提供給 WebView2。 -->
    <EmbeddedResource Include="wwwroot\**"
                      LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
                      Condition="Exists('wwwroot')" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" Condition="Exists('app.ico')" />
  </ItemGroup>

</Project>
