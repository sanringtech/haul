<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dock 的 tooltip 實測認 CFBundleName，不是 CFBundleDisplayName（跟一般認知的優先順序相反）——
	     兩個 key 都設成同一個全名，不管 macOS 這個版本讀哪一個都會顯示正確的文字。 -->
	<key>CFBundleName</key>
	<string>SanRing Usage Monitor</string>
	<key>CFBundleDisplayName</key>
	<string>SanRing Usage Monitor</string>
	<key>CFBundleExecutable</key>
	<string>SanringMonitor</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleIdentifier</key>
	<string>dev.sanring.usagemonitor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholder until the project adopts real SemVer versioning (see README staged
	     release plan) — bump by hand alongside that decision, not meant to be load-bearing yet. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
